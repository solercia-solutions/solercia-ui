{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "SolerciaUiWidget",
  "title": "Solercia UI widget schematic",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del widget (kebab-case recomendado, ej. \"stat-card\").",
      "$default": { "$source": "argv", "index": 0 }
    },
    "project": {
      "type": "string",
      "description": "Proyecto Angular objetivo. Por defecto, el proyecto de tipo application del workspace.",
      "$default": { "$source": "projectName" }
    }
  },
  "required": ["name"]
}
