import { Component, ChangeDetectionStrategy, input, output, inject } from '@angular/core';
import { I18nService } from '@shared/i18n';

/**
 * Widget generado por `ng g @solercia/ui:widget <%= name %>`.
 *
 * Standalone + `OnPush` + signals (`input()`/`output()`) + textos por clave
 * i18n (`widgets.<%= camelName %>.*`), calcado del molde de `@solercia/ui`
 * (ver `src/widgets/stat-card/ui/stat-card.component.ts` en boki-front).
 * Los widgets son bloques autónomos: pueden componer features/entities, a
 * diferencia de `shared/ui` (que solo admite componentes tontos).
 */
@Component({
  standalone: true,
  selector: '<%= selector %>',
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <div class="<%= name %>">
      <span class="<%= name %>__label">{{ titleLabel() }}</span>
      @if (value()) {
        <span class="<%= name %>__value">{{ value() }}</span>
      }
    </div>
  `,
  styles: [`
    .<%= name %> {
      display: flex;
      align-items: center;
      gap: var(--sol-space-sm, 8px);
      padding: var(--sol-space-md, 16px);
      background: var(--sol-card-bg, var(--sol-bg-surface, #fff));
      border-radius: var(--sol-card-radius, var(--sol-border-radius-lg, 12px));
    }

    .<%= name %>__label {
      color: var(--sol-color-text-secondary);
      font-size: var(--sol-font-size-sm, 12px);
    }

    .<%= name %>__value {
      color: var(--sol-color-text-primary);
      font-weight: var(--sol-font-weight-bold, 600);
    }
  `],
})
export class <%= className %>Component {
  private readonly i18n = inject(I18nService);

  /** Ajusta el tipo/valor por defecto al contrato real del widget. */
  readonly value = input<string>('');
  readonly activated = output<void>();

  readonly titleLabel = this.i18n.t('widgets.<%= camelName %>.title');
}
