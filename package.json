{
  "name": "solercia-ui-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng build @solercia/ui && ng serve showcase",
    "build:showcase": "npm run build && ng build showcase",
    "build": "ng build @solercia/ui && npm run build:schematics",
    "build:schematics": "tsc -p projects/solercia/ui/tsconfig.schematics.json && node projects/solercia/ui/schematics/build-assets.mjs",
    "test": "npm run build && ng test @solercia/ui --watch=false"
  },
  "dependencies": {
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/platform-browser": "22.0.6",
    "@angular/router": "22.0.6",
    "@dagrejs/dagre": "3.0.0",
    "chart.js": "4.5.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.6",
    "@angular/cdk": "22.0.5",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@types/node": "26.1.1",
    "jsdom": "29.1.1",
    "ng-packagr": "22.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
